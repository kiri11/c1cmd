on nativeFieldNames(scopeName)
    if scopeName is "adjustments" then return {"orientation", "rotation", "flip", "keystone amount", "keystone vertical", "keystone horizontal", "keystone skew", "keystone aspect", "color profile", "film curve", "white balance preset", "temperature", "tint", "exposure", "brightness", "contrast", "saturation", "color balance master hue", "color balance master saturation", "color balance shadow hue", "color balance shadow saturation", "color balance shadow lightness", "color balance midtone hue", "color balance midtone saturation", "color balance midtone lightness", "color balance highlight hue", "color balance highlight saturation", "color balance highlight lightness", "black and white", "black and white red sensitivity", "black and white yellow sensitivity", "black and white green sensitivity", "black and white cyan sensitivity", "black and white blue sensitivity", "black and white magenta sensitivity", "black and white split highlight hue", "black and white split highlight saturation", "black and white split shadow hue", "black and white split shadow saturation", "level highlight rgb", "level shadow rgb", "level highlight red", "level shadow red", "level highlight green", "level shadow green", "level highlight blue", "level shadow blue", "level target highlight rgb", "level target shadow rgb", "level target highlight red", "level target shadow red", "level target highlight green", "level target shadow green", "level target highlight blue", "level target shadow blue", "level midtone rgb", "level midtone red", "level midtone green", "level midtone blue", "rgb curve", "luma curve", "red curve", "green curve", "blue curve", "highlight recovery", "highlight adjustment", "shadow recovery", "white recovery", "black recovery", "clarity method", "clarity amount", "clarity structure", "dehaze amount", "dehaze color", "vignetting amount", "vignetting method", "sharpening amount", "sharpening radius", "sharpening threshold", "sharpening halo suppression", "noise reduction luminance", "noise reduction details", "noise reduction color", "noise reduction single pixel", "film grain type", "film grain impact", "film grain granularity", "moire amount", "moire pattern"}
    if scopeName is "lens" then return {"lens profile", "chromatic aberration", "custom chromatic aberration", "diffraction correction", "hide distorted areas", "distortion", "sharpness falloff", "light falloff", "focal length", "aperture", "tilt", "tilt direction", "shift", "shift direction", "shift x", "shift y"}
    if scopeName is "layer" then return {"name", "kind", "enabled", "opacity"}
    if scopeName is "luma" then return {"range low", "range high", "falloff low", "falloff high", "invert", "radius", "sensitivity"}
    if scopeName is "basicColor" then return {"name", "hue change", "saturation change", "lightness change"}
    if scopeName is "advancedColor" then return {"enabled", "red", "green", "blue", "hue start", "hue end", "saturation start", "saturation end", "smoothness", "hue change", "saturation change", "lightness change"}
    if scopeName is "variant" then return {"processing mode", "LCC color cast", "LCC dust removal", "LCC uniform light", "LCC uniform light amount"}
    error "Unknown native scope."
end nativeFieldNames
on nativeLayers(v)
    set layerValues to {}
    tell application "/Applications/Capture One.app"
        repeat with l in every layer of v
            set end of layerValues to {nativeName:(name of l as text), nativeKind:(kind of l as text), nativeOpacity:(opacity of l as integer), nativeEnabled:(enabled of l as boolean)}
        end repeat
    end tell
    return layerValues
end nativeLayers

on nativeRead(docName, variantId, scopeName, layerNumber, elementNumber, expectedPath)
    set d to my checkedDocument(docName)
    tell application "/Applications/Capture One.app" to set v to variant id variantId of d
    my assertParent(v, expectedPath)
    set t to my nativeTarget(v, scopeName, layerNumber, elementNumber)
    set rows to {}
    repeat with k in my nativeFieldNames(scopeName)
        set keyText to k as text
        try
            set val to my nativeReadField(t, scopeName, keyText)
            set nums to missing value
            set txt to missing value
            set flag to missing value
            if val is missing value then
                -- A native unset layer adjustment is distinct from an unavailable property.
            else if class of val is boolean then
                set flag to val
            else if class of val is text then
                set txt to val
            else if class of val is list then
                set nums to val
            else
                set nums to {val as real}
            end if
            set end of rows to {fieldName:keyText, numbersVal:nums, textVal:txt, boolVal:flag, unavailable:missing value}
        on error msg number num
            if num is -1712 or num is -600 or num is -609 or num is -1743 then error msg number num
            set end of rows to {fieldName:keyText, numbersVal:missing value, textVal:missing value, boolVal:missing value, unavailable:(msg & " (" & num & ")")}
        end try
    end repeat
    set basicCount to 0
    set advancedCount to 0
    if scopeName is "adjustments" then
        tell application "/Applications/Capture One.app"
            set basicCount to count of basic color corrections of color editor settings of t
            set advancedCount to count of advanced color corrections of color editor settings of t
        end tell
    end if
    return {nativeRows:rows, nativeLayers:(my nativeLayers(v)), basicColorCount:basicCount, advancedColorCount:advancedCount}
end nativeRead

on nativeEqual(a, b)
    if a is missing value or b is missing value then return a is b
    if class of a is list and class of b is list then
        if (count of a) is not (count of b) then return false
        repeat with i from 1 to count of a
            if not my nativeEqual(item i of a, item i of b) then return false
        end repeat
        return true
    end if
    if (class of a is real or class of a is integer) and (class of b is real or class of b is integer) then
        return (a - b < 0.0001 and b - a < 0.0001)
    end if
    return a is b
end nativeEqual

on nativeApply(docName, variantId, scopeName, layerNumber, elementNumber, expectedPath, expectedFields, expectedValues, expectedLayerNames, patchKeys, patchValues)
    set d to my checkedDocument(docName)
    tell application "/Applications/Capture One.app" to set v to variant id variantId of d
    my assertParent(v, expectedPath)
    set actualLayerNames to {}
    repeat with l in my nativeLayers(v)
        set end of actualLayerNames to {nativeName of l, nativeKind of l, nativeOpacity of l, nativeEnabled of l}
    end repeat
    if actualLayerNames is not expectedLayerNames then error "Layers changed before dispatch." number -27002
    set t to my nativeTarget(v, scopeName, layerNumber, elementNumber)
    repeat with i from 1 to count of expectedFields
        set actual to my nativeReadField(t, scopeName, item i of expectedFields)
        if not my nativeEqual(actual, item i of expectedValues) then error "Native editing state changed before dispatch." number -27002
    end repeat
    repeat with i from 1 to count of patchKeys
        my nativeWriteField(t, scopeName, item i of patchKeys, item i of patchValues)
    end repeat
    return true
end nativeApply
