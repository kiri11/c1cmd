on nativeWriteField(t, scopeName, fieldKey, newValue)
    tell application "/Applications/Capture One.app"
        if scopeName is "adjustments" then
            if fieldKey is "color profile" then
                set color profile of t to newValue
                return true
            end if
            if fieldKey is "film curve" then
                set film curve of t to newValue
                return true
            end if
            if fieldKey is "white balance preset" then
                set white balance preset of t to newValue
                return true
            end if
            if fieldKey is "temperature" then
                set temperature of t to newValue
                return true
            end if
            if fieldKey is "tint" then
                set tint of t to newValue
                return true
            end if
            if fieldKey is "exposure" then
                set exposure of t to newValue
                return true
            end if
            if fieldKey is "brightness" then
                set brightness of t to newValue
                return true
            end if
            if fieldKey is "contrast" then
                set contrast of t to newValue
                return true
            end if
            if fieldKey is "saturation" then
                set saturation of t to newValue
                return true
            end if
            if fieldKey is "color balance master hue" then
                set color balance master hue of t to newValue
                return true
            end if
            if fieldKey is "color balance master saturation" then
                set color balance master saturation of t to newValue
                return true
            end if
            if fieldKey is "color balance shadow hue" then
                set color balance shadow hue of t to newValue
                return true
            end if
            if fieldKey is "color balance shadow saturation" then
                set color balance shadow saturation of t to newValue
                return true
            end if
            if fieldKey is "color balance shadow lightness" then
                set color balance shadow lightness of t to newValue
                return true
            end if
            if fieldKey is "color balance midtone hue" then
                set color balance midtone hue of t to newValue
                return true
            end if
            if fieldKey is "color balance midtone saturation" then
                set color balance midtone saturation of t to newValue
                return true
            end if
            if fieldKey is "color balance midtone lightness" then
                set color balance midtone lightness of t to newValue
                return true
